# Copie para /etc/gtdone/gtdone.env (chmod 600, dono root). Não versione o arquivo real.
HOST=127.0.0.1
PORT=3000
# Endereço público HTTPS dentro da VPN; faz o SvelteKit enxergar https (cookie `secure`, proteção CSRF).
ORIGIN=https://gtdone.vpn.example
GTDONE_DB_PATH=/var/lib/gtdone/gtdone.db
GTDONE_BACKUP_DIR=/var/lib/gtdone/backups
GTDONE_BACKUP_KEEP=7
# info | warn | error
GTDONE_LOG_LEVEL=info
# Para importar exportações grandes
BODY_SIZE_LIMIT=20M
